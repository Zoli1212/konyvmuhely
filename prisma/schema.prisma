// Data model for the bilingual (hu/en) e-book store.
// Contains the models required by the Auth.js (NextAuth v5) Prisma adapter
// plus the store's own models.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer accepts connection URLs in the schema.
// Runtime connections come from the PrismaClient driver adapter (src/lib/prisma.ts);
// migration URLs live in prisma.config.ts.
datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum BookFormat {
  PDF
  EPUB
}

/// Language of a downloadable file. A book may ship a Hungarian and an English
/// edition; buying the book grants access to every file attached to it.
enum FileLocale {
  HU
  EN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// Lifecycle of the NAV-reported invoice issued through Számlázz.hu.
/// PROCESSING is a claim: exactly one worker may hold it, which is what stops
/// two code paths from issuing two invoices for the same order.
enum InvoiceStatus {
  PENDING
  PROCESSING
  ISSUED
  FAILED
  CANCELLED
}

/// Where an uploaded file physically lives. BLOB is Vercel Blob (production),
/// LOCAL is the on-disk fallback used for local development.
/// Which shelf a title sits on. The shop started as a Buddhist catalogue and
/// grew an esoteric one beside it; they share an author and a register but
/// not a readership, so the storefront keeps them apart.
enum BookCategory {
  BUDDHIST
  ESOTERIC
}

enum StorageKind {
  BLOB
  LOCAL
}

// --- Models required by Auth.js ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?   @db.Text
  /// Null for users who only ever signed in with Google.
  passwordHash  String?
  role          Role      @default(USER)
  /// Preferred store language, remembered across devices once signed in.
  locale        String    @default("hu")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// Billing details, kept so a repeat buyer does not retype them. The
  /// country is deliberately absent: this shop sells to Hungary only, which
  /// is enforced by locking the address on the Stripe customer rather than
  /// hoping the buyer picks the right country.
  billingName    String?
  billingZip     String?
  billingCity    String?
  billingAddress String? @db.Text
  /// Hungarian adószám, when the buyer is a company.
  billingTaxId   String?

  /// Reused across purchases so the locked address does not have to be
  /// recreated for every checkout.
  stripeCustomerId String? @unique

  accounts     Account[]
  sessions     Session[]
  orders             Order[]
  entitlements       Entitlement[]
  downloads          DownloadLog[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// --- Store models ---

/// Text fields come in Hungarian and English pairs. Hungarian is the required
/// base; the English variants are optional and fall back to Hungarian when
/// empty (see localizeBook in src/lib/books.ts).
model Book {
  id     String @id @default(cuid())
  slug   String @unique
  author String

  titleHu String
  titleEn String?

  subtitleHu String?
  subtitleEn String?

  /// Short description shown on cards and in list views.
  blurbHu String  @db.Text
  blurbEn String? @db.Text

  /// Longer description on the book page. Plain text; blank lines separate paragraphs.
  descriptionHu String? @db.Text
  descriptionEn String? @db.Text

  /// Price in the currency's smallest unit, exactly as Stripe expects it.
  /// See src/lib/money.ts - for HUF this is fillér, so 4990 Ft is stored as 499000.
  priceMinor Int
  currency   String @default("huf")

  coverUrl      String?      @db.Text
  coverPathname String?      @db.Text
  coverStorage  StorageKind?

  /// Shown as a detail on the book page; optional.
  pageCount Int?

  published Boolean      @default(false)
  featured  Boolean      @default(false)
  category  BookCategory @default(BUDDHIST)

  /// Shown with an 18+ mark and a warning. Set per title rather than derived
  /// from the subject, because one book in a series can need it while the
  /// rest do not.
  ageRestricted Boolean @default(false)
  /// Manual ordering on the storefront; lower comes first.
  sortIndex Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files        BookFile[]
  orderItems   OrderItem[]
  entitlements Entitlement[]

  @@index([published, sortIndex])
}

model BookFile {
  id         String      @id @default(cuid())
  bookId     String
  format     BookFormat
  fileLocale FileLocale  @default(HU)
  storage    StorageKind @default(BLOB)

  /// Vercel Blob URL for BLOB storage. Private blobs - never handed to the browser.
  url      String @db.Text
  pathname String @db.Text
  /// File name the buyer receives in the Content-Disposition header.
  fileName String

  sizeBytes Int
  createdAt DateTime @default(now())

  book      Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  downloads DownloadLog[]

  @@unique([bookId, format, fileLocale])
}

model Order {
  id                    String      @id @default(cuid())
  userId                String
  stripeSessionId       String      @unique
  stripePaymentIntentId String?
  amountMinor           Int
  currency              String
  status                OrderStatus @default(PENDING)
  customerEmail         String?
  createdAt             DateTime    @default(now())
  paidAt                DateTime?

  /// Billing details as Stripe Checkout collected them. Captured on the order
  /// rather than the user, because an invoice must reflect what was true at
  /// the moment of sale even if the customer later edits their profile.
  billingName    String?
  billingCountry String?
  billingZip     String?
  billingCity    String?
  billingAddress String? @db.Text
  /// Hungarian adószám or EU VAT number, when the buyer gave one.
  billingTaxId   String?

  /// Set once the purchase confirmation has gone out, so a webhook replay or a
  /// second visit to the return URL cannot send the buyer a duplicate.
  confirmationEmailSentAt DateTime?

  /// When the buyer expressly agreed that performance may begin at once, and
  /// acknowledged that this ends their fourteen-day right of withdrawal.
  ///
  /// 45/2014. (II. 26.) Korm. rendelet requires both the consent and the
  /// acknowledgement *before* a digital download starts, and requires the
  /// seller to be able to show it afterwards. A timestamp on the order is
  /// that proof: it is written in the same request that creates the Stripe
  /// session, so an order cannot exist without it.
  withdrawalConsentAt DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        OrderItem[]
  entitlements Entitlement[]
  invoice      Invoice?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// One invoice per paid order, issued through Számlázz.hu, which is what
/// reports it to NAV Online Számla. Stripe cannot do this: its own invoices
/// are not submitted to NAV and are not accepted as Hungarian invoices.
model Invoice {
  id      String        @id @default(cuid())
  orderId String        @unique
  status  InvoiceStatus @default(PENDING)

  /// Invoice number assigned by Számlázz.hu once issued.
  number String?

  /// The invoice PDF, stored privately and served through /api/invoice/[orderId].
  pdfStorage  StorageKind?
  pdfUrl      String?      @db.Text
  pdfPathname String?      @db.Text

  /// Amounts in minor units, as they appear on the invoice.
  netMinor   Int?
  vatMinor   Int?
  grossMinor Int?
  /// Percentage actually charged: 0 for an alanyi adómentes seller, 27 when
  /// VAT-registered (the Hungarian rate for e-books). The default only ever
  /// applies to a row that has not been issued yet.
  vatRate    Int  @default(27)

  attempts  Int       @default(0)
  lastError String?   @db.Text
  issuedAt  DateTime?

  /// When the buyer actually received the invoice PDF — attached to the
  /// purchase confirmation, or sent on its own after a retry. Null means
  /// nobody has sent it to them yet, which is the only case where a retry
  /// should mail anything: a second copy is worse than none.
  sentToBuyerAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
}

/// Single-use password reset link. Only the hash is stored, so a leaked
/// database row cannot be turned back into a working link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use email confirmation link. Carries the address it was issued for,
/// so a pending change cannot confirm a different one.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  bookId  String
  /// Title and price captured at purchase time, so receipts stay accurate
  /// even if the book is later renamed or repriced.
  titleSnapshot String
  priceMinor    Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book  Book  @relation(fields: [bookId], references: [id])

  @@unique([orderId, bookId])
}

/// One row means "this user owns this book". The single source of truth for
/// download permission. Deliberately separate from Order so that a refund,
/// a gift or a manual grant can all be expressed.
model Entitlement {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  orderId   String?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  book  Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, bookId])
}

model DownloadLog {
  id         String   @id @default(cuid())
  userId     String
  bookFileId String
  ip         String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookFile BookFile @relation(fields: [bookFileId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
