#########################################
#  Database (Postgres: Neon / Vercel Postgres / Supabase)
#########################################
# Runtime connection, POOLED. On Neon that is the "-pooler" host name;
# on Supabase it is port 6543 (pgbouncer).
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/ebook_shop?sslmode=require"
# DIRECT (non-pooled) connection used by migrations, port 5432.
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/ebook_shop?sslmode=require"

#########################################
#  Auth.js (NextAuth v5)
#########################################
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Correct automatically on Vercel; only needed behind your own domain or proxy.
AUTH_TRUST_HOST="true"

# Google OAuth - https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
# Leave both empty to hide the Google button and run with passwords only.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

#########################################
#  Stripe
#########################################
STRIPE_SECRET_KEY="sk_test_..."
# Webhook signing secret. Locally:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

#########################################
#  Vercel Blob (storage for book files and covers)
#########################################
# Create it on the Storage tab of the Vercel project; `vercel env pull` fetches it.
# If this is empty the app falls back to the local .storage/ directory,
# which only works in local development.
BLOB_READ_WRITE_TOKEN=""

#########################################
#  Invoicing (Szamlazz.hu -> NAV Online Szamla)
#########################################
# Stripe cannot issue a Hungarian invoice: its own invoices are not reported
# to NAV. Create the Agent key in your Szamlazz.hu account under
# Beallitasok -> Szamla Agent kulcsok.
SZAMLAZZ_AGENT_KEY=""

# "exempt"   - alanyi adomentes: no VAT, the invoice carries the AAM code and
#              the legal reference to the exemption. This is the default.
# "standard" - VAT-registered: STORE_VAT_RATE is charged (27 for e-books).
# The exemption ceiling is 20 million HUF in 2026, 22 million from 2027.
# Crossing it makes you VAT-registered from that point, and this must change.
STORE_VAT_MODE="exempt"
STORE_VAT_RATE="27"

#########################################
#  Email - pick ONE of the two senders
#########################################

# --- A) Gmail with an app password (no domain of your own needed) ---
# Works with a plain @gmail.com address. Requires 2-Step Verification on the
# account, then an app password from https://myaccount.google.com/apppasswords
# An app password does NOT expire, unlike an OAuth refresh token on an app
# left in Testing status, which Google kills after seven days.
GMAIL_SENDER=""
GMAIL_APP_PASSWORD=""

# --- A2) Gmail over OAuth (only worth it on Google Workspace) ---
# A Workspace domain can set the OAuth app to Internal, which skips
# verification and keeps the refresh token alive. Get the token with:
#   npx tsx scripts/gmail-token.mts
# GMAIL_CLIENT_ID=""
# GMAIL_CLIENT_SECRET=""
# GMAIL_REFRESH_TOKEN=""

# --- B) Resend (needs a sending domain you own and verify) ---
RESEND_API_KEY=""
EMAIL_FROM="Buddhista Könyvműhely <noreply@example.com>"
# Where replies go, and the reply-to printed on invoices. Optional.
STORE_REPLY_TO=""
# Who gets the "new sale" notice. Defaults to the oldest admin account.
STORE_OWNER_EMAIL=""

#########################################
#  Store
#########################################
# ISO 4217 code, lower case. See src/lib/money.ts for how minor units are handled.
NEXT_PUBLIC_STORE_CURRENCY="huf"
NEXT_PUBLIC_STORE_NAME="Buddhista Könyvműhely"
# Public base URL. Can stay empty on Vercel - VERCEL_URL is used instead.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Initial admin account created by `npm run seed`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_NAME="Adminisztrátor"
