#########################################
#  Adatbázis (Postgres: Neon / Vercel Postgres / Supabase)
#########################################
# Futásidejű, POOLOZOTT kapcsolat. Neonnál a "-pooler" hosztnév,
# Supabase-nél a 6543-as port (pgbouncer).
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/ebook_shop?sslmode=require"
# Migrációkhoz használt KÖZVETLEN kapcsolat (nem pooler, 5432).
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/ebook_shop?sslmode=require"

#########################################
#  Auth.js (NextAuth v5)
#########################################
# Generálás: npx auth secret   (vagy: openssl rand -base64 32)
AUTH_SECRET=""
# Vercelen ez automatikusan helyes; csak saját domain/proxy mögött kell állítani.
AUTH_TRUST_HOST="true"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Engedélyezett átirányítási URI-k:
#   http://localhost:3000/api/auth/callback/google
#   https://<a-te-domained>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

#########################################
#  Stripe
#########################################
STRIPE_SECRET_KEY="sk_test_..."
# A webhook aláírási titka. Helyben: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET="whsec_..."

#########################################
#  Vercel Blob (könyvfájlok és borítók tárolása)
#########################################
# A Vercel projekt Storage fülén hozható létre; `vercel env pull` lehozza.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

#########################################
#  Bolt
#########################################
# A bolt pénzneme (ISO 4217, kisbetűvel). HUF nulladecimális: 4990 = 4990 Ft.
NEXT_PUBLIC_STORE_CURRENCY="huf"
NEXT_PUBLIC_STORE_NAME="Könyvműhely"
# A nyilvános alap-URL. Helyben hagyható üresen; Vercelen a VERCEL_URL-ből jön.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Kezdeti admin fiók a `npm run seed` számára.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="valtoztasd-meg"
SEED_ADMIN_NAME="Adminisztrátor"
